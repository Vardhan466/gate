# ==============================================================================
# COC Learn & Test — Environment Configuration Template
# Copy this file to .env and supply your local or production credentials.
# DO NOT commit .env with real credentials to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Google Drive Integration / Service Account
DRIVE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL@YOUR_PROJECT_ID.iam.gserviceaccount.com
DRIVE_PRIVATE_KEY="YOUR_PRIVATE_KEY_HERE"
GOOGLE_DRIVE_FOLDER_ID=YOUR_DRIVE_FOLDER_ID_HERE

# Firebase Project Configuration
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID.firebaseio.com
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID_HERE
FIREBASE_APP_ID=YOUR_APP_ID_HERE

# Application Administrative Settings
APP_NAME="COC Learn & Test"
APP_SUPPORT_EMAIL=support@example.com
APP_ADMIN_EMAIL=admin@example.com
